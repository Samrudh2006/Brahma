# BRAHMA Environment Configuration
# SECURITY DIRECTIVE: NEVER expose private master API keys (Claude, OpenAI, Gemini, DeepSeek) in client-side VITE_ variables!
# All frontier model API keys must be retained exclusively on the backend server or in secure serverless vaults.

# Client-facing Base URLs
VITE_API_BASE_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001

# Optional Privacy-Preserving Telemetry Endpoint (Leave blank to keep disabled)
VITE_TELEMETRY_ENDPOINT=

# Backend Only Variables (DO NOT PREFIX WITH VITE_):
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIza...
# DEEPSEEK_API_KEY=sk-...
# OLLAMA_HOST=http://127.0.0.1:11434
